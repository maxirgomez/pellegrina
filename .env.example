# Copy to `.env` at repo root (and/or apps/*/.env.local). Never commit real secrets.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tierra_noble
# Used by Payload admin
# Local Docker maps host 5434 → container 5432 (avoids clash with other Postgres on 5432/5433)
DATABASE_URI=postgresql://postgres:postgres@localhost:5434/tierra_noble
# Prod (Supabase pooler): postgresql://postgres.[ref]:[PASS]@aws-0-....pooler.supabase.com:6543/postgres?sslmode=require
# Aliases also accepted by admin: DATABASE_URL / POSTGRES_URL
# One-shot schema bootstrap against empty cloud DB: PAYLOAD_DATABASE_PUSH=true

# --- Payload admin (apps/admin) ---
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=replace_with_openssl_rand_hex_32
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001
# CORS: allow only the storefront origin
STOREFRONT_URL=http://localhost:3000

# Seed credentials (pnpm seed)
SEED_ADMIN_EMAIL=admin@tierranoble.local
SEED_ADMIN_PASSWORD=ChangeMeNow!123

# --- Storefront (apps/storefront) ---
# Server-side Payload REST base URL
PAYLOAD_URL=http://localhost:3001
# Public Payload URL (aligned with Vercel env name)
PPAYLOAD_URL=http://localhost:3001

# Google reCAPTCHA v3 (https://www.google.com/recaptcha/admin — add localhost + prod domain)
# Without these keys the ticket form works without captcha (local/dev).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Optional score threshold 0.0–1.0 (default 0.5)
# RECAPTCHA_MIN_SCORE=0.5

# Resend (https://resend.com) — ticket form → email
RESEND_API_KEY=
# Remitente verificado en Resend (ej: Pellegrina <hola@tudominio.com>)
CONTACT_EMAIL_FROM=
# Casilla que recibe los pasajes del formulario
CONTACT_EMAIL_TO=

# --- Docker Compose overrides (services talk via network) ---
# Inside compose, prefer service hostnames:
# DATABASE_URI=postgresql://postgres:postgres@db:5432/tierra_noble
# PAYLOAD_URL=http://admin:3001
# PPAYLOAD_URL=http://localhost:3001
# PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001
# STOREFRONT_URL=http://localhost:3000

# --- Optional Maildev ---
# SMTP: localhost:1025  UI: http://localhost:1080
